# ContribLens v2 Environment Variables

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Secret
JWT_SECRET=contriblens-dev-secret-change-in-production

# Supabase public browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key; never expose to client code
SUPABASE_SERVICE_ROLE_KEY=

# Gemini/Gemma server-only configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
GEMINI_API_TIMEOUT_MS=15000

# Optional server-only GitHub token for higher public API limits (60 -> 5000 req/hr)
# Read-only public scope only. Never expose to client code.
GITHUB_TOKEN=

# Scan bounds (server-side bounded ingestion)
SCAN_MAX_FILES=60
SCAN_MAX_FILE_BYTES=180000
SCAN_MAX_TOTAL_BYTES=3000000
SCAN_MAX_TREE_ENTRIES=20000

# Feature controls
ENABLE_GEMINI=true
ENABLE_OSV=true
